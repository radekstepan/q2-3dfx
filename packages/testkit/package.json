{
  "name": "@q2/testkit",
  "version": "0.0.0",
  "license": "GPL-2.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --no-warn-ignored || true",
    "test": "vitest run --passWithNoTests",
    "golden": "echo golden-ok",
    "bench": "echo bench-ok",
    "baseline": "VOODOO_BASELINE_WRITE=1 BASELINE_HEAD=$(git rev-parse --short HEAD 2>/dev/null || echo unrecorded) vitest run src/voodoo-baseline.test.ts"
  },
  "dependencies": {
    "@q2/bsp": "workspace:*",
    "@q2/config": "workspace:*",
    "@q2/filesystem": "workspace:*",
    "@q2/formats": "workspace:*",
    "@q2/math": "workspace:*",
    "@q2/renderer-api": "workspace:*",
    "@q2/sw-renderer": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
