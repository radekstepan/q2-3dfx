{
  "name": "bench",
  "version": "0.0.0",
  "license": "GPL-2.0-only",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --no-warn-ignored || true",
    "test": "vitest run --passWithNoTests",
    "golden": "echo golden-ok",
    "bench": "echo bench-ok",
    "bench:frame": "node ./frame-bench.mjs",
    "bench:rgb": "node ./rgb-attr.mjs",
    "bench:accept": "node ./bench-accept.mjs",
    "bench:compare-run": "node ./compare-run.mjs",
    "bench:compare-diff": "node ./compare-diff.mjs",
    "bench:ab": "node ./ab-run.mjs",
    "bench:browser-soak": "node ./browser-soak.mjs",
    "bench:gpu-soak": "node ./gpu-soak.mjs"
  },
  "dependencies": {
    "@q2/bsp": "workspace:*",
    "@q2/config": "workspace:*",
    "@q2/formats": "workspace:*",
    "@q2/input": "workspace:*",
    "@q2/renderer-api": "workspace:*",
    "@q2/sw-renderer": "workspace:*",
    "@q2/testkit": "workspace:*",
    "@q2/voodoo": "workspace:*",
    "web": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
