{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "lib": [
      "ES2022",
      "DOM"
    ]
  }
}
